{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteroad.github.io/intelligent-audio-production-resources/schemas/datasets-v1.schema.json",
  "title": "Intelligent Audio Production dataset catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "datasets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "updatedAt": {"$ref": "#/$defs/date"},
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh": {"type": "string", "minLength": 1}
      }
    },
    "area": {
      "enum": [
        "audio-effects",
        "differentiable-processing",
        "representation",
        "mixing",
        "mastering",
        "evaluation",
        "spatial-audio"
      ]
    },
    "task": {
      "enum": [
        "effect-modeling",
        "parameter-estimation",
        "effect-control",
        "effect-transfer",
        "effect-removal",
        "representation-learning",
        "automatic-mixing",
        "mastering",
        "evaluation",
        "differentiable-processing"
      ]
    },
    "effect": {
      "enum": [
        "gain",
        "equalization",
        "compression",
        "distortion",
        "reverberation",
        "delay",
        "modulation",
        "stereo",
        "filtering",
        "multi-effect",
        "other"
      ]
    },
    "contentType": {
      "enum": [
        "multitrack",
        "stems",
        "dry-audio",
        "processed-audio",
        "dry-wet-pairs",
        "effect-parameters",
        "impulse-responses",
        "reference-mixes",
        "annotations",
        "text-prompts",
        "synthetic-audio"
      ]
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "effects", "contentTypes", "evidence"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/task"}
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/effect"}
        },
        "contentTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentType"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/httpsUrl"}
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceUrl"],
      "properties": {
        "status": {
          "enum": ["direct-download", "request", "registration", "restricted", "unavailable", "not-reviewed"]
        },
        "evidenceUrl": {
          "oneOf": [
            {"$ref": "#/$defs/httpsUrl"},
            {"type": "null"}
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh", "status", "spdx", "evidenceUrl"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh": {"type": "string", "minLength": 1},
        "status": {"enum": ["identified", "custom", "not-verified"]},
        "spdx": {"type": ["string", "null"]},
        "evidenceUrl": {
          "oneOf": [
            {"$ref": "#/$defs/httpsUrl"},
            {"type": "null"}
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidenceUrl"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidenceUrl": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["papers", "projects"],
      "properties": {
        "papers": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation"}
        },
        "projects": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation"}
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"enum": ["dataset", "paper", "project", "source", "doi"]},
        "url": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "scale",
        "areas",
        "taxonomy",
        "access",
        "license",
        "relations",
        "lastVerified",
        "links"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"$ref": "#/$defs/localized"},
        "scale": {"$ref": "#/$defs/localized"},
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/area"}
        },
        "taxonomy": {"$ref": "#/$defs/taxonomy"},
        "access": {"$ref": "#/$defs/access"},
        "license": {"$ref": "#/$defs/license"},
        "relations": {"$ref": "#/$defs/relations"},
        "lastVerified": {"$ref": "#/$defs/date"},
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/link"}
        }
      }
    }
  }
}
