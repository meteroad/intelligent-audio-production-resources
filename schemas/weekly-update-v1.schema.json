{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteroad.github.io/intelligent-audio-production-resources/schemas/weekly-update-v1.schema.json",
  "title": "Intelligent Audio Production weekly update",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publishedAt", "counts", "headline", "summary", "highlights"],
  "properties": {
    "schemaVersion": {"const": 1},
    "publishedAt": {"type": "string", "format": "date"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["papers", "projects", "datasets"],
      "properties": {
        "papers": {"type": "integer", "minimum": 0},
        "projects": {"type": "integer", "minimum": 0},
        "datasets": {"type": "integer", "minimum": 0}
      }
    },
    "headline": {"$ref": "#/$defs/localizedText"},
    "summary": {"$ref": "#/$defs/localizedText"},
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "note"],
        "properties": {
          "type": {"enum": ["paper", "project", "dataset"]},
          "id": {"type": "string", "minLength": 1},
          "note": {"$ref": "#/$defs/localizedText"}
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "zh": {"type": "string", "minLength": 1}
      }
    }
  }
}
